{
  "class_name": "Solution",
  "method_name": "twoSum",
  "param_names": ["nums", "target"],
  "test_cases": [
    {
      "input": [
        [2, 7, 11, 15],
        9
      ],
      "expected": [0, 1]
    },
    {
      "input": [
        [3, 2, 4],
        6
      ],
      "expected": [1, 2]
    },
    {
      "input": [
        [3, 3],
        6
      ],
      "expected": [0, 1]
    },
    {
      "input": [
        [1, 5, 3, 7],
        8
      ],
      "expected": [0, 3]
    },
    {
      "input": [
        [2, 5, 5, 11],
        10
      ],
      "expected": [1, 2]
    },
    {
      "input": [
        [1, 2, 3, 4, 5],
        9
      ],
      "expected": [3, 4]
    },
    {
      "input": [
        [9, 9],
        18
      ],
      "expected": [0, 1]
    },
    {
      "input": [
        [0, 4, 3, 0],
        0
      ],
      "expected": [0, 3]
    },
    {
      "input": [
        [-1, -2, -3, -4, -5],
        -8
      ],
      "expected": [2, 4]
    },
    {
      "input": [
        [2, 1, 5, 3],
        4
      ],
      "expected": [1, 3]
    }
  ]
}